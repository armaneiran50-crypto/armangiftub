# Copy to .env and fill in. Never commit .env.
DOMAIN=logirad.example.com
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 32
LOGIRAD_JWT_SECRET=
LOGIRAD_ADMIN_EMAIL=admin@logirad.example.com
LOGIRAD_ADMIN_PASSWORD=
# Outbound email (optional). Without SMTP, notifications are only logged.
LOGIRAD_SMTP_HOST=
LOGIRAD_SMTP_PORT=587
LOGIRAD_SMTP_USER=
LOGIRAD_SMTP_PASSWORD=
LOGIRAD_SMTP_FROM=Logirad <no-reply@logirad.example.com>
# WhatsApp Business Cloud API (optional)
LOGIRAD_WHATSAPP_TOKEN=
LOGIRAD_WHATSAPP_PHONE_NUMBER_ID=
# Any random string; enter the same value in Meta's webhook settings
LOGIRAD_WHATSAPP_VERIFY_TOKEN=
LOGIRAD_WHATSAPP_APP_SECRET=
# Public number for the website button, digits only, e.g. 971500000000
LOGIRAD_WHATSAPP_DISPLAY_NUMBER=
# Optional AI intake (masterplan §10)
LOGIRAD_AI_ENABLED=false
ANTHROPIC_API_KEY=
