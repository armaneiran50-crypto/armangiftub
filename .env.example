# Copy to .env and fill in. Never commit .env.
DOMAIN=logirad.example.com
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 32
LOGIRAD_JWT_SECRET=
LOGIRAD_ADMIN_EMAIL=admin@logirad.example.com
LOGIRAD_ADMIN_PASSWORD=
# Outbound email (optional). Without SMTP, notifications are only logged.
LOGIRAD_SMTP_HOST=
LOGIRAD_SMTP_PORT=587
LOGIRAD_SMTP_USER=
LOGIRAD_SMTP_PASSWORD=
LOGIRAD_SMTP_FROM=Logirad <no-reply@logirad.example.com>
# Optional AI intake (masterplan §10)
LOGIRAD_AI_ENABLED=false
ANTHROPIC_API_KEY=
